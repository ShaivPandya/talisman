# SEC fair-access User-Agent: "CompanyName ContactEmail"
# Required for live EDGAR fetches. Never commit the real value.
SEC_USER_AGENT=

# Local-process mode only (Compose sets DATABASE_URL to the db service).
DATABASE_URL=postgresql://longaeva:longaeva@127.0.0.1:55432/longaeva

# Artifact storage (created under longaeva/ when unset).
ARTIFACT_DIR=

# Optional LLM provider for later issues (LON-16 / LON-30). Absent = graceful skip.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Worker tuning
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SEC=1.0
WORKER_HEARTBEAT_PATH=/tmp/longaeva-worker-heartbeat

# Host port overrides (Compose binds to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
DB_PORT=55432
